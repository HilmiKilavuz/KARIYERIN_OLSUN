def kamera_baslat():
    """Kamerayı başlat"""
    if st.session_state.camera_obj is None:
        st.session_state.camera_obj = cv2.VideoCapture(0)
        st.session_state.camera_obj.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        st.session_state.camera_obj.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        st.session_state.camera_obj.set(cv2.CAP_PROP_FPS, 30)
    st.session_state.kamera_aktif = True

def kamera_durdur():
    """Kamerayı durdur"""
    st.session_state.kamera_aktif = False
    if st.session_state.camera_obj is not None:
        st.session_state.camera_obj.release()
        st.session_state.camera_obj = None

def frame_isle(frame_counter):
    """Tek bir frame'i işle ve analiz et"""
    if st.session_state.camera_obj is None or not st.session_state.camera_obj.isOpened():
        return None
    
    ret, frame = st.session_state.camera_obj.read()
    if not ret:
        return None
    
    # Ayna efekti
    frame = cv2.flip(frame, 1)
    h, w, _ = frame.shape
    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    
    # MediaPipe Face Mesh
    results = face_mesh.process(rgb_frame)
    
    if results.multi_face_landmarks:
        for landmarks in results.multi_face_landmarks:
            # Göz kırpma tespiti
            top_y = int(landmarks.landmark[TOP_LID].y * h)
            bottom_y = int(landmarks.landmark[BOTTOM_LID].y * h)
            eye_distance = abs(bottom_y - top_y)
            
            # Göz kırpma algılama
            if eye_distance < 5:
                if frame_counter - st.session_state.last_blink_frame > 10:
                    st.session_state.current_blinks += 1
                    st.session_state.last_blink_frame = frame_counter
            
            # Yüz bounding box çiz
            x_coords = [int(landmarks.landmark[i].x * w) for i in [234, 454, 10, 152]]
                            actions=['emotion'], 
                            enforce_detection=False, 
                            silent=True
                        )
                        
                        emotion = analysis[0]['dominant_emotion']
                        
                        # Türkçe çeviri
                        emotion_tr = {
                            'happy': 'Mutlu',
                            'sad': 'Üzgün',
                            'angry': 'Kızgın',
                            'fear': 'Gergin',
                            'neutral': 'Nötr',
                            'disgust': 'İğrenme',
                            'surprise': 'Şaşkın'
                        }.get(emotion, emotion)
                        
                        st.session_state.current_emotions.append(emotion_tr)
                except Exception as e:
                    pass
    
    # Bilgileri frame üzerine yaz
    cv2.putText(frame, "KAYIT ALINIYOR", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)
    cv2.putText(frame, f"Goz Kirpma: {st.session_state.current_blinks}", (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)
    
    if st.session_state.current_emotions:
        son_duygu = st.session_state.current_emotions[-1]
        cv2.putText(frame, f"Duygu: {son_duygu}", (10, 90), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
    
    return frame

def ai_ile_puanla(soru, cevap, api_key):
    """OpenAI ile cevabı puanla"""
    if not api_key:
        return "⚠️ API Key bulunamadı. Puanlama yapılamadı."
    
    try:
        client = OpenAI(api_key=api_key)
        prompt = f"""Aşağıdaki mülakat sorusu ve cevabını değerlendir:

SORU: {soru}

CEVAP: {cevap}

Lütfen aşağıdaki formatta değerlendir:
1. Puan (0-10): 
2. Güçlü Yönler:
3. Geliştirilebilir Alanlar:
4. Öneriler:

Profesyonel ve yapıcı bir dille değerlendir."""

        response = client.chat.completions.create(
            model="gpt-3.5-turbo",
            messages=[{"role": "user", "content": prompt}],
            temperature=0.7,
            max_tokens=500
        )
        
        return response.choices[0].message.content
    except Exception as e:
        return f"⚠️ AI Puanlama Hatası: {str(e)}"

def duygu_grafiği_olustur(emotions_list):
    """Duygu dağılımı için pasta grafiği oluştur"""
    if not emotions_list:
        return None
    
    emotion_counts = Counter(emotions_list)
    
    fig = go.Figure(data=[go.Pie(
        labels=list(emotion_counts.keys()),
        values=list(emotion_counts.values()),
        hole=0.3,
        marker=dict(colors=['#FF6B6B', '#4ECDC4', '#45B7D1', '#FFA07A', '#98D8C8', '#F7DC6F', '#BB8FCE'])
    )])
    
    fig.update_layout(
        title="Duygu Durumu Dağılımı",
        height=300,
        margin=dict(l=20, r=20, t=40, b=20)
    )
    
    return fig

