                st.session_state.frame_counter += 1
                
                st.success("✅ Kamera çalışıyor - Cevabınızı yazmaya başlayabilirsiniz")
                
                # Auto-rerun için - performans optimize edildi
                if st.session_state.frame_counter % 10 == 0:  # Her 10 frame'de bir rerun (daha az kasma)
                    time.sleep(0.05)
                    st.rerun()
        
        with col_right:
            st.markdown("### ✍️ Cevabınız")
            
            with st.form(key=f"form_{st.session_state.soru_index}"):
