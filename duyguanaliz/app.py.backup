                            ai_feedback = ai_ile_puanla(soru_metni, cevap, api_key)
                        
                        # Verileri kaydet
                        st.session_state.analiz_data.append({
                            'soru': soru_metni,
                            'cevap': cevap,
                            'emotions': st.session_state.current_emotions.copy(),
                            'blinks': st.session_state.current_blinks,
                            'ai_feedback': ai_feedback
                        })
                        
                        # Sıfırla
                        st.session_state.current_emotions = []
                        st.session_state.current_blinks = 0
                        st.session_state.last_blink_frame = 0
                        
                        # Sonraki soruya geç
                        st.session_state.soru_index += 1
                        st.rerun()